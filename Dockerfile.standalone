# Single-image educational mission console: React build + FastAPI.
# Expose via an authenticated TLS gateway before inviting public traffic.
FROM node:22-alpine AS frontend-builder
WORKDIR /build/frontend
COPY frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    ASTRA_WEB_DIST=/app/web_dist ASTRA_OFFLINE=1
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY backend/ ./backend/
RUN python -m pip install --no-cache-dir .
COPY --from=frontend-builder /build/frontend/dist/ /app/web_dist/
EXPOSE 8000
# PORT is provided by many container hosts; offline mode defaults on for public demos.
CMD ["sh", "-c", "exec uvicorn backend.standalone:app --host 0.0.0.0 --port ${PORT:-8000}"]
