# Set ASTRA_OFFLINE=1 for a fully deterministic, no-network demo.
ASTRA_OFFLINE=0
# Backend: 8000, Vite development: 5173, Docker frontend: 3000.

# Optional single-account HTTP Basic gate, FOR STANDALONE HOSTING ONLY.
# Only use over a trusted HTTPS reverse proxy; credentials belong in the host's secret store.
# ASTRA_DEMO_AUTH=1
# ASTRA_DEMO_USER=your-private-reviewer-name
# ASTRA_DEMO_PASSWORD=set-a-long-unique-secret-in-the-host-not-GitHub
